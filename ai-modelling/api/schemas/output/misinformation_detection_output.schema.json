{
  "$defs": {
    "MisinformationTaskOut": {
      "additionalProperties": false,
      "properties": {
        "label_id": {
          "minimum": 0,
          "title": "Label Id",
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        },
        "risk_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "label_id",
        "label",
        "confidence",
        "probabilities",
        "risk_score",
        "severity"
      ],
      "title": "MisinformationTaskOut",
      "type": "object"
    },
    "TaskPrediction": {
      "additionalProperties": false,
      "properties": {
        "label_id": {
          "minimum": 0,
          "title": "Label Id",
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "label_id",
        "label",
        "confidence",
        "probabilities"
      ],
      "title": "TaskPrediction",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "author_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Name"
    },
    "platform": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform"
    },
    "content": {
      "title": "Content",
      "type": "string"
    },
    "share_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Share Count"
    },
    "ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ts"
    },
    "post_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Post Url"
    },
    "misinformation": {
      "$ref": "#/$defs/MisinformationTaskOut"
    },
    "urgency": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskPrediction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "humanitarian_task": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskPrediction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "checkpoint": {
      "title": "Checkpoint",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "domain",
    "id",
    "content",
    "misinformation",
    "checkpoint"
  ],
  "title": "Multi-task Misinformation Detection Output",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "misinformation_detection_output.schema.json",
  "description": "Output schema for DeBERTa multi-task classification of misinformation, urgency, and humanitarian categories."
}
